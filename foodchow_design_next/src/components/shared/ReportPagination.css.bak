.report-pagination-wrapper {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  margin-top: 24px !important;
  margin-bottom: 20px !important;
  width: 100% !important;
  clear: both !important;
  font-family: inherit;
  color: #64748b;
  font-size: 13px;
}

.report-pagination-left {
  display: flex;
  align-items: center;
  gap: 8px;
}

.report-pagination-select {
  padding: 4px 8px;
  border: 1px solid #cbd5e1;
  border-radius: 4px;
  background-color: #fff;
  font-size: 13px;
  color: #334155;
  outline: none;
  cursor: pointer;
}

.report-pagination-select:focus {
  border-color: #00a699;
}

.report-pagination-right {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  user-select: none;
}

.report-nav-text-btn {
  border: none;
  background: transparent;
  font-size: 13px;
  font-weight: 500;
  color: #cbd5e1; /* Default greyish for disabled/inactive */
  cursor: pointer;
  padding: 0;
  transition: color 0.15s ease-in-out;
}

.report-nav-text-btn:hover:not(:disabled) {
  color: #0f766e; /* Teal when hovered */
}

.report-nav-text-btn:not(:disabled) {
  color: #94a3b8; /* slightly darker if active */
}

.report-nav-text-btn:disabled {
  color: #e2e8f0;
  cursor: not-allowed;
}

.report-page-numbers {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.report-num-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 28px;
  height: 28px;
  padding: 0 8px;
  border: 1px solid transparent;
  background: transparent;
  border-radius: 4px; /* Rounded square instead of pill */
  font-size: 13px;
  font-weight: 500;
  color: #64748b;
  cursor: pointer;
  transition: all 0.15s ease-in-out;
}

.report-num-btn:hover:not(:disabled):not(.active) {
  color: #0f172a;
  background-color: #f1f5f9;
}

.report-num-btn.active {
  background-color: #0f766e; /* Teal */
  color: #ffffff;
  font-weight: 600;
  border-color: #0f766e;
  box-shadow: 0 1px 2px rgba(15, 118, 110, 0.3);
}

.report-ellipsis {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 20px;
  height: 28px;
  font-size: 13px;
  color: #94a3b8;
}