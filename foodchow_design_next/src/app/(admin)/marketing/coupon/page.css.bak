/* ============================================================================
   marketing/coupon.html — page styles, scoped to #pg-marketing-coupon.
   :root custom-props and @keyframes stay at top level. The #hide-duplicate-sidebars
   block and the header/sidebar-only rules are dropped (shell owns those).
   Original class names preserved verbatim.
   ============================================================================ */

:root {
  --primary-color: #00a896;
  --primary-dark: #008f7f;
  --sidebar-bg: #ffffff;
  --main-bg: #f5f7fa;
  --text-dark: #333333;
  --text-light: #666666;
  --border-color: #e0e0e0;
  --active-bg: #e6f7f5;
  /* coupon page extras */
  --teal: #0AA89E;
  --teal-dark: #088c83;
  --teal-light: #B6E5E2;
  --teal-tint: #e0f5f4;
  --ink: #2d3748;
  --muted: #5d6b78;
  --faint: #90a0ac;
  --line: #e6eaee;
  --bg: #f4f6f9;
  --white: #ffffff;
  --radius: 14px;
  --radius-sm: 10px;
  --font: 'Poppins', 'Inter', 'Segoe UI', system-ui, sans-serif;
  --font-heading: 'Unbounded', 'Poppins', sans-serif;
  --red: #ef4444;
}

@keyframes dropdownFade {
  from {
    opacity: 0;
    transform: scale(.95) translateY(-6px)
  }

  to {
    opacity: 1;
    transform: scale(1) translateY(0)
  }
}

@keyframes popIn {
  from {
    opacity: 0;
    transform: scale(.95)
  }

  to {
    opacity: 1;
    transform: scale(1)
  }
}

#pg-marketing-coupon {
  /* base, lifted from the original body rule onto the page wrapper */
  background: var(--main-bg);

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0
  }

  .btn-solid {
    background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
    border: none;
    color: white;
    padding: 10px 18px;
    border-radius: 6px;
  font-size: var(--text-button); line-height: var(--lh-button);
  font-weight: var(--weight-semibold);
    cursor: pointer;
    transition: all .2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 2px 6px rgba(0, 168, 150, .15);
  }

  .btn-solid:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(0, 168, 150, .3);
  }

  .btn-help-hdr {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: #ffffff;
    border: 1.5px solid var(--border-color);
    border-radius: 6px;
    color: var(--text-light);
  font-size: var(--text-button); line-height: var(--lh-button);
  font-weight: var(--weight-semibold);
    cursor: pointer;
    transition: all .2s ease;
    outline: none;
    height: 38px;
  }

  .btn-help-hdr:hover {
    border-color: var(--primary-color);
    color: var(--primary-color);
    background: var(--active-bg);
    transform: translateY(-1px);
  }

  .btn-help-hdr svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .topbar-dropdown {
    position: relative;
    display: inline-block;
  }

  .btn-outline-teal {
    background: white;
    border: 1.5px solid var(--primary-color);
    color: var(--primary-color);
    padding: 9px 18px;
    border-radius: 6px;
  font-size: var(--text-button); line-height: var(--lh-button);
  font-weight: var(--weight-semibold);
    cursor: pointer;
    transition: all .2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    outline: none;
  }

  .btn-outline-teal:hover {
    background: var(--active-bg);
  }

  .dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: #ffffff;
    border: 1.5px solid var(--primary-color);
    border-radius: 6px;
    box-shadow: 0 4px 12px rgba(0, 0, 0, .08);
    min-width: 180px;
    z-index: 1000;
    overflow: hidden;
    transform-origin: top right;
  }

  .dropdown-menu.show {
    display: block;
    animation: dropdownFade .2s cubic-bezier(.16, 1, .3, 1);
  }

  .dropdown-menu a {
    display: block;
    padding: 10px 16px;
  font-size: var(--text-helper); line-height: var(--lh-helper);
    color: var(--text-dark);
    text-decoration: none;
    text-align: left;
    transition: all .15s;
  }

  .dropdown-menu a:hover {
    background: var(--active-bg);
    color: var(--primary-color);
    padding-left: 20px;
  }

  /* ===== LAYOUT ===== */
  .app-container {
    display: flex;
    width: 100%;
    height: calc(100vh - 60px);
  }

  /* ===== MAIN CONTENT WRAPPER ===== */
  .main-content {
    flex-grow: 1;
    overflow-y: auto;
    background: var(--bg);
    padding: 24px;
  }

  /* ===== PAGE CARD — white box with rounded corners like Category page ===== */
  .pg-card {
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid var(--line);
    padding: 28px 32px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
  }

  .content-area {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .view {
    display: none
  }

  .view.active {
    display: block
  }

  .content-area {
    padding: 28px 32px
  }

  /* ===== WHITE CARD WRAPPER (matches Payment Gateway page) ===== */
  .pg-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px 32px;
    overflow: hidden;
  }
  
  .pg-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0;
  }

  .pg-divider {
    border: none;
    margin: 20px -32px 20px;
  }

  /* LIST VIEW */
  .list-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0
  }

  .list-header-left h2 {
    color: var(--ink);
    font-weight: 700;
    color: var(--ink)
  }

  .list-header-left p {
  font-size: var(--text-helper); line-height: var(--lh-helper);
    color: var(--muted);
    margin-top: 2px
  }

  .list-header-btns {
    display: flex;
    gap: 10px
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 20px;
    background: var(--teal);
    border: none;
    border-radius: 8px;
    color: #fff;
  font-size: var(--text-button); line-height: var(--lh-button);
  font-weight: var(--weight-semibold);
    cursor: pointer;
    transition: .15s;
    box-shadow: 0 2px 6px rgba(10, 168, 158, .25);
    letter-spacing: .02em
  }

  .btn-primary:hover {
    background: var(--teal-dark);
    transform: translateY(-1px)
  }

  .btn-primary svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: #fff;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round
  }

  .btn-outline-pg {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 20px;
    border: 1.5px solid var(--teal);
    border-radius: 8px;
    background: transparent;
    color: var(--teal);
  font-size: var(--text-button); line-height: var(--lh-button);
  font-weight: var(--weight-semibold);
    cursor: pointer;
    transition: .15s
  }

  .btn-outline-pg:hover {
    background: var(--teal-tint)
  }

  .btn-outline-pg svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 22px
  }

  .stat-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 16px 18px;
    display: flex;
    align-items: center;
    gap: 14px
  }

  .stat-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0
  }

  .stat-icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round
  }

  .stat-icon.teal {
    background: var(--teal-tint);
    color: var(--teal)
  }

  .stat-icon.green {
    background: #d1fae5;
    color: #059669
  }

  .stat-icon.amber {
    background: #fef3c7;
    color: #d97706
  }

  .stat-icon.red {
    background: #fee2e2;
    color: #dc2626
  }

  .stat-value {
  font-size: var(--text-section-heading); line-height: var(--lh-section-heading);
  font-weight: var(--weight-bold);
    color: var(--ink);
    line-height: 1;
    font-family: var(--font-heading)
  }

  .stat-label {
    font-size: 11.5px;
    color: var(--muted);
    margin-top: 3px;
    font-weight: 500
  }

  .table-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden
  }

  .table-card-header {
    padding: 16px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line)
  }

  .table-card-header span {
  font-size: var(--text-label); line-height: var(--lh-label);
  font-weight: var(--weight-bold);
    color: var(--ink)
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border: 1.5px solid var(--line);
    border-radius: 8px;
    background: #f8fafb
  }

  .search-box input {
    border: none;
    background: transparent;
    outline: none;
  font-size: var(--text-input); line-height: var(--lh-input);
    color: var(--ink);
    width: 180px;
    font-family: var(--font)
  }

  .search-box input::placeholder {
    color: var(--faint)
  }

  .search-box svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: var(--faint);
    stroke-width: 2;
    flex-shrink: 0
  }

  .table-wrap {
    overflow-x: auto
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px
  }

  thead tr {
    background: #f0faf9;
    border-bottom: 2px solid var(--teal-light)
  }

  thead th {
    padding: 13px 16px;
    text-align: left;
  font-size: var(--text-table);
  font-weight: var(--weight-semibold); line-height: var(--lh-table);
    color: var(--teal-dark);
    white-space: nowrap;
    letter-spacing: .04em;
    text-transform: uppercase
  }

  tbody tr {
    border-bottom: 1px solid var(--line);
    transition: background .1s
  }

  tbody tr:last-child {
    border-bottom: none
  }

  tbody tr:hover {
    background: #f8fafb
  }

  tbody td {
    padding: 14px 16px;
  font-size: var(--text-table);
    color: var(--ink);
    vertical-align: middle
  }

  .coupon-code-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 14px;
    border: 1.5px dashed #9dd4d0;
    border-radius: 6px;
  font-size: var(--text-helper); line-height: var(--lh-helper);
  font-weight: var(--weight-bold);
    color: var(--teal-dark);
    background: var(--teal-tint);
    font-family: 'Courier New', monospace;
    letter-spacing: .08em
  }

  .badge-yes {
    display: inline-block;
    padding: 4px 14px;
    border-radius: 20px;
  font-size: var(--text-helper); line-height: var(--lh-helper);
  font-weight: var(--weight-bold);
    background: #d1fae5;
    color: #065f46
  }

  .badge-no {
    display: inline-block;
    padding: 4px 14px;
    border-radius: 20px;
  font-size: var(--text-helper); line-height: var(--lh-helper);
  font-weight: var(--weight-bold);
    background: #fee2e2;
    color: #991b1b
  }

  .act-btns {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px
  }

  .icon-btn {
    width: 34px;
    height: 34px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all .2s ease;
    flex-shrink: 0;
  }

  .icon-btn svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .edit-btn {
    background: #e6f9f8;
    color: #0AA89E
  }

  .edit-btn:hover {
    background: #0AA89E;
    color: #fff
  }

  .delete-btn {
    background: #fff1f2;
    color: #f43f5e
  }

  .delete-btn:hover {
    background: #ef4444;
    color: #fff
  }

  .toggle-switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
    cursor: pointer
  }

  .toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0
  }

  .slider {
    position: absolute;
    inset: 0;
    background: #cbd5e0;
    border-radius: 24px;
    transition: .25s
  }

  .slider::before {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    left: 3px;
    bottom: 3px;
    background: #fff;
    border-radius: 50%;
    transition: .25s;
    box-shadow: 0 1px 3px rgba(0, 0, 0, .2)
  }

  .toggle-switch input:checked+.slider {
    background: var(--teal)
  }

  .toggle-switch input:checked+.slider::before {
    transform: translateX(20px)
  }

  .type-col {
    font-weight: 700
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--muted)
  }

  .empty-state svg {
    width: 56px;
    height: 56px;
    margin: 0 auto 16px;
    display: block;
    fill: none;
    stroke: #cbd5e0;
    stroke-width: 1.4
  }

  .empty-state p {
  font-size: var(--text-body);
    font-weight: 600
  }

  /* FORM VIEW */
  .form-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px
  }

  .form-topbar-left {
    display: flex;
    align-items: center;
    gap: 12px
  }

  .back-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: #fff;
    border: 1.5px solid var(--line);
    border-radius: 8px;
  font-size: var(--text-helper); line-height: var(--lh-helper);
  font-weight: var(--weight-semibold);
    color: var(--muted);
    cursor: pointer;
    transition: .15s;
    text-decoration: none
  }

  .back-btn:hover {
    border-color: var(--teal);
    color: var(--teal)
  }

  .back-btn svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5
  }

  .form-title-block h2 {
  font-size: var(--text-subheading); line-height: var(--lh-subheading);
  font-weight: var(--weight-bold);
    color: var(--ink)
  }

  .form-title-block p {
  font-size: var(--text-helper); line-height: var(--lh-helper);
    color: var(--muted);
    margin-top: 1px
  }

  .form-topbar-actions {
    display: flex;
    gap: 10px
  }

  .form-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 22px;
    align-items: start
  }

  .section-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 18px
  }

  .section-card:last-child {
    margin-bottom: 0
  }

  .section-card-head {
    padding: 16px 22px;
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: flex-start;
    gap: 12px
  }

  .section-num {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--teal);
    color: #fff;
  font-size: var(--text-helper); line-height: var(--lh-helper);
  font-weight: var(--weight-bold);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-family: var(--font-heading);
    margin-top: 2px
  }

  .section-card-head h3 {
  font-size: var(--text-label); line-height: var(--lh-label);
  font-weight: var(--weight-bold);
    color: var(--ink)
  }

  .section-card-head p {
  font-size: var(--text-helper); line-height: var(--lh-helper);
    color: var(--muted);
    margin-top: 2px
  }

  .section-body {
    padding: 22px 22px 20px
  }

  .form-group {
    margin-bottom: 18px
  }

  .form-group:last-child {
    margin-bottom: 0
  }

  .form-label {
    display: block;
  font-size: var(--text-label); line-height: var(--lh-label);
  font-weight: var(--weight-semibold);
    color: var(--ink);
    margin-bottom: 7px
  }

  .form-label .req {
    color: #ef4444;
    margin-left: 2px
  }

  .form-control {
    width: 100%;
    padding: 10px 14px;
    border: 1.5px solid var(--line);
    border-radius: 8px;
  font-size: var(--text-input); line-height: var(--lh-input);
    font-family: var(--font);
    color: var(--ink);
    background: #fff;
    transition: border .15s, box-shadow .15s;
    outline: none
  }

  .form-control:focus {
    border-color: var(--teal);
    box-shadow: 0 0 0 3px rgba(10, 168, 158, .12)
  }

  .form-control.error {
    border-color: #ef4444 !important;
    box-shadow: 0 0 0 3px rgba(239, 68, 68, .1)
  }

  .err-msg {
  font-size: var(--text-helper); line-height: var(--lh-helper);
    color: #ef4444;
    margin-top: 5px;
    display: none
  }

  .err-msg.show {
    display: block
  }

  .code-input-wrap {
    display: flex;
    gap: 8px
  }

  .code-input-wrap .form-control {
    flex: 1;
    font-family: 'Courier New', monospace;
  font-weight: var(--weight-regular);
    letter-spacing: .1em;
    font-size: var(--text-input); line-height: var(--lh-input);
    background: var(--teal-tint);
    border: 1.5px solid var(--teal-light);
    border-radius: 8px;
    color: var(--teal-dark);
  font-size: var(--text-button); line-height: var(--lh-button);
  font-weight: var(--weight-semibold);
    cursor: pointer;
    white-space: nowrap;
    transition: .15s;
    font-family: var(--font)
  }

  .btn-gen:hover {
    background: var(--teal);
    color: #fff;
    border-color: var(--teal)
  }

  .chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px
  }

  .chip-label {
    cursor: pointer
  }

  .chip-label input {
    display: none
  }

  .chip-label span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    border: 1.5px solid var(--line);
    border-radius: 8px;
  font-size: var(--text-helper); line-height: var(--lh-helper);
  font-weight: var(--weight-semibold);
    color: var(--muted);
    background: #f8fafb;
    transition: all .15s;
    user-select: none
  }

  .chip-label input:checked+span {
    border-color: var(--teal);
    background: var(--teal-tint);
    color: var(--teal-dark)
  }

  .chip-label span::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 2px solid currentColor;
    transition: all .15s;
    flex-shrink: 0
  }

  .chip-label input:checked+span::before {
    background: var(--teal);
    border-color: var(--teal)
  }

  .checkbox-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px
  }

  .cbchip-label {
    cursor: pointer
  }

  .cbchip-label input {
    display: none
  }

  .cbchip-label span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 18px;
    border: 1.5px solid var(--line);
    border-radius: 8px;
  font-size: var(--text-helper); line-height: var(--lh-helper);
  font-weight: var(--weight-semibold);
    color: var(--muted);
    background: #f8fafb;
    transition: all .15s;
    user-select: none
  }

  .cbchip-label input:checked+span {
    border-color: var(--teal);
    background: var(--teal-tint);
    color: var(--teal-dark)
  }

  .cbchip-label span svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    flex-shrink: 0
  }

  .amount-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px
  }

  .preview-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 18px
  }

  .preview-card-head {
    background: var(--teal);
    padding: 16px 20px
  }

  .preview-card-head h3 {
  font-size: var(--text-helper); line-height: var(--lh-helper);
  font-weight: var(--weight-bold);
    color: #fff;
    text-transform: uppercase;
    letter-spacing: .06em
  }

  .preview-card-head p {
  font-size: var(--text-helper); line-height: var(--lh-helper);
    color: rgba(255, 255, 255, .8);
    margin-top: 2px
  }

  .coupon-visual {
    margin: 18px;
    background: linear-gradient(135deg, var(--teal-tint) 0%, #fff 100%);
    border: 2px dashed var(--teal-light);
    border-radius: 12px;
    padding: 20px 22px;
    position: relative;
    overflow: hidden
  }

  .coupon-visual::before {
    content: '';
    position: absolute;
    left: -12px;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    background: var(--bg);
    border-radius: 50%;
    border: 2px solid var(--line)
  }

  .coupon-visual::after {
    content: '';
    position: absolute;
    right: -12px;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    background: var(--bg);
    border-radius: 50%;
    border: 2px solid var(--line)
  }

  .cv-type {
    font-size: 10.5px;
  font-weight: var(--weight-bold);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .08em;
    margin-bottom: 4px
  }

  .cv-code {
    font-family: 'Courier New', monospace;
    font-size: 21px;
  font-weight: var(--weight-bold);
    color: var(--teal-dark);
    letter-spacing: .12em;
    line-height: 1;
    margin-bottom: 8px
  }

  .cv-discount {
  font-size: var(--text-helper); line-height: var(--lh-helper);
  font-weight: var(--weight-bold);
    color: var(--ink);
    margin-bottom: 2px
  }

  .cv-minorder {
  font-size: var(--text-helper); line-height: var(--lh-helper);
    color: var(--muted)
  }

  .cv-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 10px
  }

  .cv-tag {
    padding: 3px 10px;
    background: var(--teal);
    color: #fff;
    border-radius: 20px;
  font-size: var(--text-helper); line-height: var(--lh-helper);
    font-weight: 700
  }

  .tips-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden
  }

  .tips-card-head {
    padding: 14px 20px;
    border-bottom: 1px solid var(--line)
  }

  .tips-card-head h3 {
  font-size: var(--text-helper); line-height: var(--lh-helper);
  font-weight: var(--weight-bold);
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 8px
  }

  .tips-card-head h3 svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--teal);
    stroke-width: 2
  }

  .tips-list {
    padding: 14px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px
  }

  .tip-item {
    display: flex;
    align-items: flex-start;
    gap: 8px
  }

  .tip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
    flex-shrink: 0;
    margin-top: 6px
  }

  .tip-item p {
  font-size: var(--text-helper); line-height: var(--lh-helper);
    color: var(--muted);
    line-height: 1.5
  }

  .form-actions-bar {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 18px 22px;
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: 0
  }

  .btn-submit {
    padding: 11px 32px;
    background: var(--teal);
    border: none;
    border-radius: 8px;
    color: #fff;
  font-size: var(--text-button); line-height: var(--lh-button);
  font-weight: var(--weight-semibold);
    font-family: var(--font);
    cursor: pointer;
    letter-spacing: .05em;
    text-transform: uppercase;
    transition: .15s;
    box-shadow: 0 3px 10px rgba(10, 168, 158, .3)
  }

  .btn-submit:hover {
    background: var(--teal-dark);
    transform: translateY(-1px)
  }

  .btn-cancel2 {
    padding: 11px 24px;
    background: #f1f5f9;
    border: 1.5px solid var(--line);
    border-radius: 8px;
    color: var(--muted);
  font-size: var(--text-button); line-height: var(--lh-button);
  font-weight: var(--weight-semibold);
    font-family: var(--font);
    cursor: pointer;
    letter-spacing: .05em;
    text-transform: uppercase;
    transition: .15s
  }

  .btn-cancel2:hover {
    background: #e2e8f0;
    color: var(--ink)
  }

  .confirm-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, .45);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999
  }

  .confirm-overlay.show {
    display: flex
  }

  .confirm-box {
    background: #fff;
    border-radius: 16px;
    padding: 36px 32px;
    max-width: 420px;
    width: 90%;
    text-align: center;
    box-shadow: 0 24px 60px rgba(0, 0, 0, .18);
    animation: popIn .18s ease
  }

  .confirm-icon {
    width: 56px;
    height: 56px;
    background: #fee2e2;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px
  }

  .confirm-icon svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: #dc2626;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round
  }

  .confirm-box h3 {
    font-size: 17px;
  font-weight: var(--weight-bold);
    color: var(--ink);
    margin-bottom: 8px
  }

  .confirm-box p {
  font-size: var(--text-helper); line-height: var(--lh-helper);
    color: var(--muted);
    margin-bottom: 24px;
    line-height: 1.6
  }

  .confirm-actions {
    display: flex;
    gap: 10px;
    justify-content: center
  }

  .btn-del-confirm {
    padding: 11px 28px;
    background: #ef4444;
    border: none;
    border-radius: 8px;
    color: #fff;
  font-size: var(--text-button); line-height: var(--lh-button);
  font-weight: var(--weight-semibold);
    cursor: pointer;
    transition: .15s
  }

  .btn-del-confirm:hover {
    background: #dc2626
  }

  .btn-del-cancel {
    padding: 11px 22px;
    background: #f1f5f9;
    border: 1.5px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
  font-size: var(--text-button); line-height: var(--lh-button);
  font-weight: var(--weight-semibold);
    cursor: pointer;
    transition: .15s
  }

  .btn-del-cancel:hover {
    background: #e2e8f0
  }

  .toast {
    position: fixed;
    bottom: 28px;
    right: 28px;
    background: var(--teal);
    color: #fff;
    padding: 13px 22px;
    border-radius: 10px;
  font-size: var(--text-helper); line-height: var(--lh-helper);
  font-weight: var(--weight-semibold);
    box-shadow: 0 6px 20px rgba(10, 168, 158, .3);
    z-index: 99999;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity .3s, transform .3s;
    pointer-events: none
  }

  .toast.show {
    opacity: 1;
    transform: translateY(0)
  }

  .toast.err {
    background: #ef4444
  }

  /* ── STEP FOOTER ── */
  .step-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0 8px;
    margin-top: 24px;
    flex-shrink: 0;
    background: transparent;
  }

  .btn-prev,
  .btn-next {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--teal);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 10px 22px;
  font-size: var(--text-button); line-height: var(--lh-button);
  font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    font-family: var(--font);
    transition: 0.15s;
  }

  .btn-prev:hover,
  .btn-next:hover {
    background: var(--teal-dark);
  }

  .step-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    border: 2px dashed #ccc;
    border-radius: 10px;
    padding: 6px 22px;
  }

  .step-label {
  font-size: var(--text-helper); line-height: var(--lh-helper);
  font-weight: var(--weight-semibold);
    color: #aaa;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .step-value {
    font-size: 17px;
  font-weight: var(--weight-bold);
    color: var(--teal);
  }
}
