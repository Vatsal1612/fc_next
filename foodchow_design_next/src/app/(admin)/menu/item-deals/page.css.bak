  font-weight: var(--weight-semibold);
  font-size: var(--text-button);
  line-height: var(--lh-button);
  cursor: pointer;
  margin-bottom: 24px;
}

.section-heading {
  font-size: var(--text-body);
  font-weight: var(--weight-bold);
  color: var(--text-primary, #1e293b);
  margin-bottom: 8px;
}

.offer-item {
  font-size: var(--text-label);
  line-height: var(--lh-label);
  color: var(--text-primary, #334155);
  margin-bottom: 6px;
}

.offer-hint {
  font-size: var(--text-helper);
  color: var(--text-secondary, #64748b);
  margin-bottom: 24px;
  line-height: 1.4;
}

/* Form Fields */
.form-grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.form-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.input-label {
  width: 200px;
  font-size: var(--text-label);
  line-height: var(--lh-label);
  color: var(--text-primary, #334155);
}

.number-input {
  width: 140px;
  padding: 8px 12px;
  border: 1px solid var(--border-color, #cbd5e1);
  border-radius: 6px;
  font-size: var(--text-input);
  line-height: var(--lh-input);
}

.btn-select-tax {
  background-color: var(--teal, #00a896);
  color: #ffffff;
  border: none;
  padding: 8px 14px;
  border-radius: 6px;
  font-size: var(--text-button);
  line-height: var(--lh-button);
  font-weight: var(--weight-semibold);
  cursor: pointer;
}

/* Nested Modals */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1100;
}

.nested-modal {
  background: #ffffff;
  border-radius: 8px;
  width: 100%;
  max-width: 500px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
  overflow: hidden;
}

.nested-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid #e2e8f0;
}

.nested-modal-header h3 {
  font-size: var(--text-body);
  font-weight: var(--weight-bold);
  color: #334155;
  margin: 0;
}

.close-btn {
  background: none;
  border: none;
  font-size: var(--text-section-heading);
  line-height: var(--lh-section-heading);
  cursor: pointer;
  color: #64748b;
}

.nested-modal-body {
  padding: 20px;
  max-height: 380px;
  overflow-y: auto;
}

.nested-modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  padding: 16px 20px;
  border-top: 1px solid #e2e8f0;
}

.btn-modal-cancel {
  background: #ef4444;
  color: #ffffff;
  border: none;
  padding: 8px 18px;
  border-radius: 4px;
  font-weight: var(--weight-semibold);
  font-size: var(--text-button);
  line-height: var(--lh-button);
  cursor: pointer;
}

.btn-modal-save {
  background: var(--teal, #00a896);
  color: #ffffff;
  border: none;
  padding: 8px 22px;
  border-radius: 4px;
  font-weight: var(--weight-semibold);
  font-size: var(--text-button);
  line-height: var(--lh-button);
  cursor: pointer;
}

/* Accordion & Checkboxes */
.accordion-item {
  border-bottom: 1px solid #f1f5f9;
  padding: 8px 0;
}

.accordion-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
}

.checkbox-container {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: var(--text-label);
  line-height: var(--lh-label);
  color: #334155;
  cursor: pointer;
}

.checkbox-container input {
  accent-color: var(--teal, #00a896);
  width: 16px;
  height: 16px;
}

.accordion-content {
  padding-left: 24px;
  margin-top: 8px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

/* Tax Options */
.tax-options-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 20px;
}

.tax-summary-box {
  border-top: 1px solid #e2e8f0;
  padding-top: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-label);
  line-height: var(--lh-label);
  color: #475569;
}

.summary-row.total {
  font-weight: var(--weight-bold);
  color: #1e293b;
}

.step2-scroll {
  height: 400px;
  overflow-y: scroll;
}

.tax-calculation-display {
  margin-top: 10px;
  padding: 10px 12px;
  border: 1px solid #e5e7eb;
  border-radius: 6px;
  background: #f8fafc;
  min-width: 240px;
}

.tax-calculation-row {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  font-size: var(--text-helper);
  line-height: var(--lh-helper);
  margin-bottom: 6px;
}

.tax-calculation-row:last-child {
  margin-bottom: 0;
}

.tax-total {
  padding-top: 7px;
  margin-top: 7px;
  border-top: 1px solid #d1d5db;
  font-weight: var(--weight-bold);
}

.step3-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding-right: 10px;
  box-sizing: border-box;
}

.step3-card {
  padding: 30px 20px;
}

.restriction-section {
  margin-bottom: 28px;
}

.restriction-heading {
  font-size: var(--text-subheading);
  line-height: var(--lh-subheading);
  font-weight: var(--weight-bold);
  margin-bottom: 14px;
}

.restriction-option {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
  font-size: var(--text-body);
}

.restriction-option input {
  width: 18px;
  height: 18px;
  cursor: pointer;
}

/* ==============================
   SELECT TAX MODAL
============================== */

.tax-modal {
  width: 500px;
  max-width: 90%;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
}

/* Header */

.tax-modal .nested-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid #e5e7eb;
  flex-shrink: 0;
}

.tax-modal .nested-modal-header h3 {
  margin: 0;
  font-size: var(--text-body);
  font-weight: var(--weight-semibold);
}

/* Body */

.tax-modal .nested-modal-body {
  padding: 20px;
  overflow-y: auto;
  flex: 1;
  min-height: 0;
}

/* Included / Excluded */

.tax-mode-row {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 20px;
}

.tax-mode-row strong {
  font-size: var(--text-label);
  line-height: var(--lh-label);
  margin-right: 10px;
}


/* Tax list */

.tax-options-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.checkbox-container {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 13px;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #fafafa;
  cursor: pointer;
}

.checkbox-container:hover {
  background: #afebe6;
  border-color: #00a39b;
}

.checkbox-container input {
  width: 17px;
  height: 17px;
  cursor: pointer;
  accent-color: #00a39b;
}

.checkbox-container span {
  font-size: var(--text-label);
  line-height: var(--lh-label);
  color: #333;
}

/* Tax summary */

.tax-summary-box {
  margin-top: 20px;
  padding: 15px;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #f9fafb;
}

.summary-row {
  display: grid;
  grid-template-columns: 1fr 20px 90px;
  gap: 5px;
  padding: 7px 0;
  font-size: var(--text-helper);
  line-height: var(--lh-helper);
}

.summary-row span:last-child {
  text-align: right;
}

.summary-row.total {
  margin-top: 8px;
  padding-top: 12px;
  border-top: 1px solid #ddd;
  font-weight: var(--weight-semibold);
}

/* Footer */

.tax-modal .nested-modal-footer {
  display: flex;
  justify-content: flex-end;
  padding: 14px 20px;
  border-top: 1px solid #e5e7eb;
  flex-shrink: 0;
}

.btn-modal-save {
  padding: 9px 24px;
  border: none;
  border-radius: 6px;
  background: #00a39b;
  color: white;
  font-size: var(--text-button);
  line-height: var(--lh-button);
  font-weight: var(--weight-semibold);
  cursor: pointer;
}

.btn-modal-save:hover {
  opacity: 0.9;
}

/* Remove box styling only from accordion checkboxes */

.accordion-item .checkbox-container {
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
}

.final-step-message {
  margin-bottom: 25px;
}

.final-step-buttons {
  display: flex;
  align-items: center;
  gap: 15px;
}

.deals-table tbody tr {
  cursor: grab;
}

.deals-table tbody tr:active {
  cursor: grabbing;
}

.deals-table tbody tr.dragging-row {
  opacity: 0.5;
  background: #f1f1f1;
}

.item-size-dropdown {
  margin: 8px 0 12px 34px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.size-dropdown-label {
  font-size: var(--text-helper);
  line-height: var(--lh-helper);
  font-weight: var(--weight-semibold);
  color: #334155;
}

.size-select {
  min-width: 160px;
  padding: 8px 32px 8px 10px;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
  background-color: #ffffff;
  color: #334155;
  font-size: var(--text-input);
  line-height: var(--lh-input);
  cursor: pointer;
  outline: none;
}

.size-select:focus {
  border-color: #00a39b;
}

.size-select:hover {
  border-color: #00a39b;
}